# ── Copy this file to .env and fill in your values ──
# DO NOT commit .env to GitHub

# Server
PORT=5000
NODE_ENV=development

# MongoDB Atlas
MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/hakim?appName=Cluster0

# JWT — use a long random string
JWT_SECRET=change-this-to-a-long-random-secret-key

# OpenRouter AI
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENROUTER_MODEL=openai/gpt-4o-mini

# Frontend URL (set this to your Vercel domain after deploying)
# Example: https://hakim-wellness.vercel.app
FRONTEND_URL=http://localhost:5000
